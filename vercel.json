{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://sum-backend-secado-gnsgzjfoqa-uc.a.run.app/api/:path*" },
    { "source": "/mobile/:path*", "destination": "https://sum-backend-secado-gnsgzjfoqa-uc.a.run.app/mobile/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ]
}
