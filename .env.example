# Copia este archivo como `.env.local` y completa los valores. `.env.local` no se versiona.
#
# Credenciales de PRUEBA de la base de DESARROLLO, para las pruebas que van contra el backend real.
# Un usuario con rol `operario` y `traslado` en `allowed_apps`. Nunca uses credenciales de producción.
TRASLADO_USUARIO=
TRASLADO_CLAVE=

# Opcional: a dónde apunta el proxy de desarrollo (por defecto http://localhost:8050).
# VITE_PROXY_TARGET=http://localhost:8050
